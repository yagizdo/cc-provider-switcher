{
  "providers": {
    "deepseek": {
      "name": "DeepSeek",
      "baseUrl": "https://api.deepseek.com/anthropic",
      "defaultModel": "deepseek-flash",
      "aliases": ["ds"],
      "keyEnvVar": "DEEPSEEK_API_KEY",
      "models": { "sonnet": "deepseek-flash", "opus": "deepseek-flash", "haiku": "deepseek-flash" },
      "supportedCapabilities": ["effort", "thinking"],
      "thinkingNote": "budget_tokens ignored, uses reasoning_effort internally"
    },
    "minimax": {
      "name": "MiniMax",
      "baseUrl": "https://api.minimax.io/anthropic",
      "defaultModel": "MiniMax-M3.1-Flash",
      "aliases": ["mm"],
      "keyEnvVar": "MINIMAX_API_KEY",
      "regions": {
        "global": "https://api.minimax.io/anthropic",
        "china": "https://api.minimaxi.com/anthropic"
      },
      "models": { "sonnet": "MiniMax-M3.1-Flash", "opus": "MiniMax-M3.1-Flash", "haiku": "MiniMax-M3.1-Flash" },
      "supportedCapabilities": ["effort", "max_effort", "thinking"],
      "thinkingNote": "Always thinks (disabled returns 400). Effort: low/medium/high/xhigh/max"
    },
    "kimi": {
      "name": "Kimi",
      "baseUrl": "https://api.moonshot.ai/anthropic",
      "defaultModel": "kimi-k3.1-pro",
      "aliases": ["kimi2"],
      "keyEnvVar": "KIMI_API_KEY",
      "regions": {
        "global": "https://api.moonshot.ai/anthropic",
        "china": "https://api.moonshot.cn/anthropic"
      },
      "models": { "sonnet": "kimi-k3.1-pro", "opus": "kimi-k3.1-pro", "haiku": "kimi-k3.1-pro-highspeed" },
      "supportedCapabilities": ["effort", "thinking"]
    },
    "qwen": {
      "name": "Qwen",
      "baseUrl": "https://coding-intl.dashscope.aliyuncs.com/apps/anthropic",
      "defaultModel": "qwen3.7-plus",
      "aliases": [],
      "keyEnvVar": "QWEN_API_KEY",
      "regions": {
        "global": "https://coding-intl.dashscope.aliyuncs.com/apps/anthropic",
        "china": "https://coding.dashscope.aliyuncs.com/apps/anthropic"
      },
      "models": {
        "sonnet": "qwen3.7-plus",
        "opus": "qwen3.7-plus",
        "haiku": "qwen3.7-plus"
      },
      "supportedCapabilities": ["effort", "thinking"],
      "thinkingNote": "Supports thinking_budget for token-level control"
    },
    "glm": {
      "name": "GLM",
      "baseUrl": "https://api.z.ai/api/anthropic",
      "defaultModel": "glm-5.3",
      "aliases": ["glm5"],
      "keyEnvVar": "GLM_API_KEY",
      "regions": {
        "global": "https://api.z.ai/api/anthropic",
        "china": "https://open.bigmodel.cn/api/anthropic"
      },
      "models": { "sonnet": "glm-5.3", "opus": "glm-5.3", "haiku": "glm-5.3-flash" },
      "supportedCapabilities": ["effort", "max_effort", "thinking"],
      "thinkingNote": "Always reasons (disabled fails). Effort: low/high/max"
    },
    "seed": {
      "name": "Seed/Doubao",
      "baseUrl": "https://ark.cn-beijing.volces.com/api/coding",
      "defaultModel": "ark-code-latest",
      "aliases": ["doubao"],
      "keyEnvVar": "ARK_API_KEY",
      "models": {
        "sonnet": "ark-code-latest",
        "opus": "ark-code-latest",
        "haiku": "ark-code-latest"
      },
      "supportedCapabilities": ["thinking"],
      "thinkingNote": "Thinking on/off only, no effort levels"
    },
    "stepfun": {
      "name": "StepFun",
      "baseUrl": "https://api.stepfun.ai",
      "defaultModel": "step-3.7-flash",
      "aliases": ["sf"],
      "keyEnvVar": "STEPFUN_API_KEY",
      "models": {
        "sonnet": "step-3.7-flash",
        "opus": "step-3.7-flash",
        "haiku": "step-3.7-flash"
      },
      "supportedCapabilities": ["effort", "thinking"],
      "thinkingNote": "Effort levels: none/low/medium/high"
    },
    "openrouter": {
      "name": "OpenRouter",
      "baseUrl": "https://openrouter.ai/api",
      "defaultModel": "anthropic/claude-sonnet-5.5",
      "aliases": ["or"],
      "keyEnvVar": "OPENROUTER_API_KEY",
      "models": {
        "sonnet": "anthropic/claude-sonnet-5.5",
        "opus": "anthropic/claude-opus-5.5",
        "haiku": "anthropic/claude-haiku-5.5"
      }
    },
    "lmstudio": {
      "name": "LM Studio",
      "baseUrl": "http://127.0.0.1:1234",
      "defaultModel": "qwen/qwen3.8-27b",
      "aliases": ["lms"],
      "keyEnvVar": "LMSTUDIO_API_KEY",
      "keyOptional": true,
      "models": {
        "sonnet": "qwen/qwen3.8-27b",
        "opus": "qwen/qwen3.8-27b",
        "haiku": "qwen/qwen3.8-27b"
      },
      "thinkingNote": "Local model. Use --model <id> to pick another one"
    }
  }
}
